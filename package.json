{
  "name": "app-crypto-kit",
  "version": "1.0.1",
  "description": "End-to-end file encryption for Expo apps on iOS and Android: AES-256-GCM on the device, main key in the Keychain / Keystore, a recovery key that unlocks it on a new device (iPhone or Android). The backend only ever stores ciphertext and a wrapped key. No app's words or backend are built in.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "sideEffects": false,
  "license": "MIT",
  "author": "Yuvaraj Salla",
  "dependencies": {
    "@noble/hashes": "1.8.0"
  },
  "peerDependencies": {
    "expo-crypto": ">=15",
    "expo-file-system": ">=19",
    "expo-secure-store": ">=15",
    "react": ">=18",
    "react-native": ">=0.74"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/node": "^22.10.0",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.13",
    "expo-secure-store": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  }
}
